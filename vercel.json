{
  "headers": [
    {
      "source": "/ingest/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/email-journeys",
      "schedule": "0 1 * * *"
    }
  ]
}
